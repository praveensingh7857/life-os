{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Executive task with priorities and status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["Urgent", "High", "Medium", "Low"] },
        "status": { "type": "string", "enum": ["Todo", "In Progress", "Completed"] },
        "category": { "type": "string" },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "priority", "status", "createdAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Time-sensitive reminders and schedule alerts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "isRecurring": { "type": "boolean" },
        "recurrenceRule": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "time", "date", "isCompleted", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Approved user context and long-term memory",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "confidence": { "type": "number" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "isApproved", "createdAt"]
    },
    "Finance": {
      "title": "Finance",
      "description": "Financial income and expense transaction",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["Expense", "Income"] },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "amount", "type", "category", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "User reminders"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/Memory" },
      "description": "User long-term memories"
    },
    "/users/{userId}/finances/{financeId}": {
      "schema": { "$ref": "#/entities/Finance" },
      "description": "User financial transactions"
    }
  }
}
